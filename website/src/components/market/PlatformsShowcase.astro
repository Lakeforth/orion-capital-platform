---
// Dark "Powerful Trading Platforms" band (TradingPlatformsSection.jsx and the
// matching block on every market page): blobs, lead + store badges, crossfading screen,
// and an accordion list with a lime active bar. One open item at a time; click swaps
// the screen. `title` is trusted markup (accent span) from our own page data.
import { platforms } from '../../data/markets.js';
import { links } from '../../config/site.js';

interface Props { title?: string; lead?: string; active?: number; id?: string }
const {
  title = 'Powerful <span class="text-accent">Trading Platforms</span>',
  lead = 'Trade anytime, anywhere<br />using a range of fast,<br />reliable platforms designed<br />for real-time control<br />and execution.',
  active = 0,
  id = 'platforms',
} = Astro.props;
---
<section id={id} class="relative isolate flex w-full flex-col items-center overflow-hidden bg-navy" data-platforms>
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute left-[-253px] top-[-248px] h-[647px] w-[750px] opacity-60">
      <img src="/images/home/blob-1.svg" alt="" class="absolute left-0 top-[149px] h-[398px] w-[237px]" />
      <img src="/images/home/blob-2.svg" alt="" class="absolute left-[243px] top-0 h-[266px] w-[497px]" />
    </div>
    <div class="absolute right-[-100px] top-[307px] h-[662px] w-[729px] opacity-60 lg:left-[916px] lg:right-auto">
      <img src="/images/home/blob-3.svg" alt="" class="absolute left-0 top-[157px] h-[304px] w-[430px]" />
      <img src="/images/home/blob-4.svg" alt="" class="absolute left-[292px] top-0 h-[461px] w-[313px]" />
    </div>
  </div>

  <div class="shell flex flex-col gap-12 py-12 lg:gap-9 lg:py-10">
    <h2 class="reveal t-section text-center text-white" set:html={title} />

    <div class="flex w-full flex-col items-center justify-between gap-12 lg:flex-row lg:items-stretch lg:gap-5">
      <div class="reveal flex w-full flex-col justify-center gap-9 lg:max-w-[486px] lg:flex-1">
        <p class="t-card text-center text-white lg:text-left" set:html={lead} />
        <!-- Store badges removed: the working destination is WebTrader itself. -->
        <div class="flex w-full flex-col items-center gap-3 lg:items-start">
          <a href={links.webtrader} class="btn-primary">Launch WebTrader</a>
          <p class="text-center text-[13px] leading-[18px] text-white/70 lg:text-left">Runs in any browser, including on your phone.</p>
        </div>
      </div>

      <div class="relative aspect-[612/631] w-full min-w-0 max-w-[612px] lg:flex-[1.3]">
        {platforms.map((p, i) => (
          <img
            src={`/images/home/${p.img}.webp`} alt={`${p.title} interface`} width="612" height="631"
            loading="lazy" decoding="async" data-platform-img={i}
            class={`absolute inset-0 h-full w-full object-cover object-center transition-opacity duration-700 ease-in-out ${i === active ? 'z-10 opacity-100' : 'z-0 opacity-0'}`}
          />
        ))}
      </div>

      <div class="flex w-full flex-col gap-6 lg:max-w-[350px] lg:flex-1">
        {platforms.map((p, i) => (
          <button
            type="button" data-platform={i} aria-expanded={i === active ? 'true' : 'false'}
            class="group flex w-full items-stretch gap-3 text-left"
          >
            <span class={`w-0.5 shrink-0 rounded-[24px] transition-colors duration-300 ${i === active ? 'bg-lime' : 'bg-white group-hover:bg-gray-400'}`} data-bar></span>
            <span class="flex w-full flex-col">
              <span class={`text-[clamp(16px,1.71vw,26px)] font-medium leading-[1.3846] transition-colors duration-300 ${i === active ? 'text-lime' : 'text-white group-hover:text-gray-300'}`} data-title>
                {p.title}
              </span>
              <span
                class="grid transition-[grid-template-rows,opacity,margin] duration-300 ease-in-out"
                style={i === active ? 'grid-template-rows:1fr;opacity:1;margin-top:6px' : 'grid-template-rows:0fr;opacity:0;margin-top:0'}
                data-desc
              >
                <span class="overflow-hidden text-[15px] font-medium leading-4 text-white">{p.desc}</span>
              </span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  for (const plat of document.querySelectorAll<HTMLElement>('[data-platforms]')) {
    const buttons = Array.from(plat.querySelectorAll<HTMLElement>('[data-platform]'));
    const imgs = Array.from(plat.querySelectorAll<HTMLElement>('[data-platform-img]'));
    buttons.forEach((btn, idx) => btn.addEventListener('click', () => {
      buttons.forEach((b, i) => {
        const on = i === idx;
        b.setAttribute('aria-expanded', String(on));
        const bar = b.querySelector('[data-bar]');
        const title = b.querySelector('[data-title]');
        const desc = b.querySelector<HTMLElement>('[data-desc]');
        bar?.classList.toggle('bg-lime', on); bar?.classList.toggle('bg-white', !on);
        title?.classList.toggle('text-lime', on); title?.classList.toggle('text-white', !on);
        if (desc) {
          desc.style.gridTemplateRows = on ? '1fr' : '0fr';
          desc.style.opacity = on ? '1' : '0';
          desc.style.marginTop = on ? '6px' : '0';
        }
      });
      imgs.forEach((im, i) => {
        const on = i === idx;
        im.classList.toggle('opacity-100', on); im.classList.toggle('z-10', on);
        im.classList.toggle('opacity-0', !on); im.classList.toggle('z-0', !on);
      });
    }));
  }
</script>
