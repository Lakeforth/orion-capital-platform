---
import Icon from '../ui/Icon.astro';
import { links } from '../../config/site.js';

// Sample rows only. These are STATIC illustrative figures, labelled as such in the UI —
// never present them as live quotes. Wire `data-quote-symbol` to the tenant's price
// feed to make them real; the markup is already shaped for it.
interface Row { symbol: string; name: string; price: string; change: string }
interface Props { title?: string; lead?: string; groups: { label: string; rows: Row[] }[]; tone?: 'white'|'band'; }
const { title, lead, groups, tone = 'white' } = Astro.props;
---
<section class={`section ${tone === 'band' ? 'band' : 'bg-white'}`}>
  <div class="shell">
    {title && (
      <div class="mb-8 max-w-3xl">
        <h2 class="text-balance">{title}</h2>
        {lead && <p class="mt-3 text-body text-muted">{lead}</p>}
      </div>
    )}

    <div class="border border-line bg-white">
      <div class="flex gap-1 overflow-x-auto border-b border-line px-2 no-bar" role="tablist">
        {groups.map((g, i) => (
          <button
            type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="shrink-0 border-b-2 border-transparent px-4 py-3 text-small text-muted transition-colors hover:text-ink aria-selected:border-brand aria-selected:font-semibold aria-selected:text-ink"
            data-tab={i}
          >{g.label}</button>
        ))}
      </div>

      {groups.map((g, i) => (
        <div id={`panel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} hidden={i !== 0} data-panel={i}>
          <!-- table-fixed + explicit column widths, deliberately. With the default auto
               layout the table's min-content width (~383px) propagated past the scroll
               wrapper and dragged the whole page sideways by ~11-24px on a 360px phone.
               Neither min-width:0 on the table nor max-width on the wrapper fixed it;
               only a fixed layout did. The wrapper still scrolls if the content needs it. -->
          <div class="overflow-x-auto">
          <table class="w-full table-fixed text-small">
            <colgroup>
              <col class="w-[42%]" /><col class="w-[22%]" /><col class="w-[18%]" /><col class="w-[18%]" />
            </colgroup>
            <caption class="sr-only">{g.label} — indicative prices</caption>
            <thead>
              <tr class="border-b border-line text-left text-micro uppercase tracking-wide text-muted">
                <th scope="col" class="px-4 py-3 font-medium">Instrument</th>
                <th scope="col" class="px-4 py-3 text-right font-medium">Price</th>
                <th scope="col" class="px-4 py-3 text-right font-medium">Change</th>
                <th scope="col" class="px-4 py-3 text-right font-medium"><span class="sr-only">Trade</span></th>
              </tr>
            </thead>
            <tbody>
              {g.rows.map((r) => {
                const up = !r.change.startsWith('-');
                return (
                  <tr class="border-b border-line last:border-0 hover:bg-band/60" data-quote-symbol={r.symbol}>
                    <th scope="row" class="px-4 py-3 text-left font-normal">
                      <span class="block truncate font-medium text-ink">{r.name}</span>
                      <span class="ml-2 text-micro text-muted">{r.symbol}</span>
                    </th>
                    <td class="px-4 py-3 text-right tabular-nums" data-quote-price>{r.price}</td>
                    <td class={`px-4 py-3 text-right tabular-nums ${up ? 'text-[#0a8f4d]' : 'text-[#d02d2d]'}`} data-quote-change>
                      {r.change}
                    </td>
                    <td class="px-4 py-3 text-right">
                      <a href={links.webtrader} class="inline-flex items-center gap-1 text-small font-semibold text-brand hover:underline">
                        Trade<Icon name="chevron-r" size={14} />
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-3 text-micro text-muted">
      Indicative prices shown for illustration only. They are not live quotes and are not
      executable. Spreads and availability vary by account type and market conditions.
    </p>
  </div>
</section>

<script>
  document.querySelectorAll('[data-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const i = btn.getAttribute('data-tab');
      const scope = btn.closest('section');
      scope.querySelectorAll('[data-tab]').forEach((b) =>
        b.setAttribute('aria-selected', String(b === btn)));
      scope.querySelectorAll('[data-panel]').forEach((p) =>
        p.hidden = p.getAttribute('data-panel') !== i);
    });
  });
</script>
