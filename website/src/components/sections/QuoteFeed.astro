---
// Drives every [data-quote-symbol] row on the page from the tenant's market-data service.
// Drop this component once per page that has quote rows; it finds them itself.
//
// Design rules this follows, in order of importance:
//
//  1. Never show a number that might be wrong. If the feed cannot be reached, or returns
//     nothing for an instrument, the price is blanked and the block says so — it does NOT
//     fall back to the figure baked into the HTML, because that figure is a design
//     placeholder and drifts further from reality every day. (feed.blankWhenUnavailable)
//  2. State is per symbol, not per block. One missing instrument blanks one row.
//  3. A closed market is a distinct state from a broken feed. The service tells us which
//     via `isTradable` / `session`, so a frozen weekend price is labelled, not disguised.
//  4. Only text nodes are written. Rows are never re-rendered and `hidden` is never
//     touched — the explorer's search filter owns that, and fighting it would break it.
import { feed, quoteMap } from '../../config/feed.js';
---
{feed.enabled && (
  <script type="application/json" data-quote-config set:html={JSON.stringify({ feed, quoteMap })}></script>
)}

<script>
  const cfgEl = document.querySelector('[data-quote-config]');
  if (cfgEl) {
    const { feed, quoteMap } = JSON.parse(cfgEl.textContent || '{}');

    const rows = Array.from(document.querySelectorAll('[data-quote-symbol]'))
      .map((el) => ({ el, display: el.getAttribute('data-quote-symbol') || '' }))
      .map((r) => ({ ...r, map: quoteMap[r.display] }))
      .filter((r) => r.map);

    if (rows.length) {
      const ids = [...new Set(rows.map((r) => r.map.id))];
      // First live price per instrument, for the session-relative % change.
      const baseline = new Map();

      const fmt = (n, dp, group) =>
        Number(n).toLocaleString('en-US', {
          minimumFractionDigits: dp,
          maximumFractionDigits: dp,
          useGrouping: !!group,
        });

      // Writing only when the string actually changes avoids churning the DOM on every
      // poll for a price that has not moved.
      const setText = (el, text) => {
        if (!el || el.textContent === text) return false;
        el.textContent = text;
        return true;
      };

      // Colour the price text by the direction of its last move; it holds until the next.
      const tint = (el, tone) => el?.setAttribute('data-tone', tone);

      const blankRow = (row) => {
        const priceEl = row.el.querySelector('[data-quote-price]');
        const changeEl = row.el.querySelector('[data-quote-change]');
        setText(priceEl, '—');
        setText(changeEl, '—');
        changeEl?.setAttribute('data-tone', 'flat');
        row.el.setAttribute('data-quote-state', 'unavailable');
      };

      const paint = (row, asset) => {
        const priceEl = row.el.querySelector('[data-quote-price]');
        const changeEl = row.el.querySelector('[data-quote-change]');
        const { dp, group } = row.map;

        const last = row.el.getAttribute('data-quote-last'); // null before the first paint
        const prev = Number(last);
        const next = Number(asset.price);
        setText(priceEl, fmt(next, dp, group));
        row.el.setAttribute('data-quote-last', String(next));

        // Compare raw values, not the formatted text: a move smaller than the displayed
        // precision still colours the price, as TradingView's widgets do.
        if (last !== null && Number.isFinite(prev) && prev !== next) {
          tint(priceEl, next > prev ? 'up' : 'down');
        }

        // Only crypto carries a 24h change. Everything else shows the move since the first
        // live price this visitor received, which is real but session-relative, so the
        // block's [data-iw-basis] note is revealed to say so.
        let pct = asset.changePercent24h;
        if (!(typeof pct === 'number' && Number.isFinite(pct))) {
          if (!baseline.has(row.map.id)) baseline.set(row.map.id, next);
          const base = baseline.get(row.map.id);
          pct = base ? ((next - base) / base) * 100 : 0;
          row.el.closest('[data-quote-block]')?.querySelector('[data-iw-basis]')?.removeAttribute('hidden');
        }
        const sign = pct > 0 ? '+' : '';
        setText(changeEl, `${sign}${pct.toFixed(2)}%`);
        changeEl?.setAttribute('data-tone', pct > 0 ? 'up' : pct < 0 ? 'down' : 'flat');

        const age = Date.now() - new Date(asset.lastUpdated).getTime();
        const closed = asset.isTradable === false || asset.session === 'non-tradeable';
        row.el.setAttribute(
          'data-quote-state',
          closed ? 'closed' : age > feed.staleAfterMs ? 'stale' : 'live'
        );
      };

      // One status line per block, describing that block's rows rather than the whole page.
      const setStatus = (text) => {
        for (const block of document.querySelectorAll('[data-quote-block]')) {
          const out = block.querySelector('[data-quote-status]');
          if (!out) continue;
          const kids = Array.from(block.querySelectorAll('[data-quote-symbol][data-quote-state]'));
          if (!kids.length) { out.textContent = text; continue; }
          const states = kids.map((k) => k.getAttribute('data-quote-state'));
          const n = (s) => states.filter((x) => x === s).length;
          out.textContent =
            text ? text
            : n('live') ? `Live · updates every ${Math.round(feed.pollMs / 1000)}s`
            : n('closed') ? 'Market closed — last traded price'
            : n('stale') ? 'Delayed — awaiting fresh prices'
            : 'Prices unavailable';
        }
      };

      let failures = 0;

      // At a 2s poll a slow response can outlive the interval; skip rather than stack.
      let inFlight = false;

      const tick = async () => {
        if (inFlight) return;
        inFlight = true;
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), feed.timeoutMs);
        try {
          const url = `${feed.baseUrl}/api/asset/symbols?symbols=${encodeURIComponent(ids.join(','))}`;
          const res = await fetch(url, { signal: ctrl.signal, cache: 'no-store' });
          const json = await res.json();

          // The service answers 404 + success:false when it holds no data at all, which is
          // a legitimate state (its upstream is down), not a transport error.
          if (!json?.success || !Array.isArray(json.data) || json.data.length === 0) {
            failures += 1;
            rows.forEach(blankRow);
            setStatus('Prices unavailable');
            return;
          }

          failures = 0;
          const bySymbol = new Map(json.data.map((a) => [a.symbol, a]));
          for (const row of rows) {
            const asset = bySymbol.get(row.map.id);
            if (asset && Number.isFinite(Number(asset.price))) paint(row, asset);
            else blankRow(row);
          }
          setStatus('');
        } catch (e) {
          failures += 1;
          rows.forEach(blankRow);
          setStatus('Prices unavailable');
        } finally {
          clearTimeout(timer);
          inFlight = false;
        }
      };

      // Mark rows as pending immediately so a finished-looking static number is never the
      // thing on screen while the first request is still in flight.
      if (feed.blankWhenUnavailable !== false) {
        rows.forEach((r) => r.el.setAttribute('data-quote-state', 'pending'));
      }

      tick();
      let id = setInterval(tick, feed.pollMs);

      // A background tab should not keep polling; catch up the moment it is looked at.
      document.addEventListener('visibilitychange', () => {
        clearInterval(id);
        if (document.visibilityState === 'visible') {
          tick();
          id = setInterval(tick, feed.pollMs);
        }
      });
    }
  }
</script>
