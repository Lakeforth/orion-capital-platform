---
import Icon from '../ui/Icon.astro';
interface Props {
  title?: string; lead?: string;
  items: { icon?: string; title: string; text: string }[];
  cols?: 2|3|4; tone?: 'white'|'band'|'dark';
}
const { title, lead, items, cols = 3, tone = 'white' } = Astro.props;
const bg = tone === 'dark' ? 'band-dark' : tone === 'band' ? 'band' : 'bg-white';
const grid = { 2:'sm:grid-cols-2', 3:'sm:grid-cols-2 lg:grid-cols-3', 4:'sm:grid-cols-2 lg:grid-cols-4' }[cols];
---
<section class={`section ${bg}`}>
  <div class="shell">
    {title && (
      <div class="mb-10 max-w-3xl">
        <h2 class="text-balance">{title}</h2>
        {lead && <p class={`mt-3 text-body ${tone === 'dark' ? 'text-white/70' : 'text-muted'}`}>{lead}</p>}
      </div>
    )}
    <div class={`grid gap-x-8 gap-y-10 ${grid}`}>
      {items.map((it) => (
        <div>
          {it.icon && (
            <div class={`mb-4 flex h-11 w-11 items-center justify-center ${tone === 'dark' ? 'bg-white/10 text-sky' : 'bg-band text-brand'}`}>
              <Icon name={it.icon} size={22} />
            </div>
          )}
          <h3 class="text-h4">{it.title}</h3>
          <p class={`mt-2 text-small ${tone === 'dark' ? 'text-white/65' : 'text-muted'}`}>{it.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
