---
// Account Types — a copy of the owner's "Global Investment Account Comparison" sheet
// (account-types.jpg): a title tab, six tall cards with clipped top corners, a pointed
// base and a double metal frame, a coin medallion overlapping the top with a hexagonal
// name plate, "MINIMUM DEPOSIT:" and the amount over a short rule, a ticked list with
// hairline dividers, and "INVESTMENT ACCOUNTS ONLY" beneath. Only the colour is reduced:
// each tier has one flat metal tone (copper, bronze, silver, gold, platinum; gold on black
// for VIP) instead of the sheet's metallic shading, glows and chart backdrop.
// Cards read from src/data/pricing.js `accountTypes[].features`.
// The reference's "88.89% of retail investor accounts lose money" is AvaTrade's own
// figure and is replaced by compliance.lossPercentage.
import Base from '../layouts/Base.astro';
import MarketCrumbs from '../components/market/MarketCrumbs.astro';
import Icon from '../components/ui/Icon.astro';
import { accountTypes } from '../data/pricing.js';
import { compliance, links, site } from '../config/site.js';

// One flat metal tone per tier and a darker shade of it for the name plate. `card` makes
// the VIP card black as on the sheet.
const metal: Record<string, { tone: string; deep: string; card?: string }> = {
  standard: { tone: '#D49A82', deep: '#7B4B3A' },
  bronze:   { tone: '#B48352', deep: '#654326' },
  silver:   { tone: '#C8CFD8', deep: '#59616E' },
  gold:     { tone: '#D8B456', deep: '#76591D' },
  platinum: { tone: '#B9C9DA', deep: '#4D5F74' },
  vip:      { tone: '#D8B456', deep: '#17140C', card: '#0A0A0B' },
};
const cardBg = '#0E1C31';
const cream = '#F4ECDF';

// Card outline: clipped top corners and a pointed base. The frame is four stacked layers
// (outer metal, gap, inner metal line, body) because a clip-path cannot carry a border.
const shape = 'polygon(16px 0, calc(100% - 16px) 0, 100% 16px, 100% calc(100% - 26px), 50% 100%, 0 calc(100% - 26px), 0 16px)';
const plate = 'polygon(14px 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 14px 100%, 0 50%)';
const gem = (cls: string) => `<svg class="${cls}" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 4h12l4 5-10 11L2 9z" fill="#EEF2F7"/><path d="M2 9h20M9 4l3 16 3-16" fill="none" stroke="#9AA6B5" stroke-width="1"/></svg>`;
---
<Base
  title="Account Types | Choose Your Trading Account | Orion Capital"
  description={`Compare Orion Capital trading accounts — ${accountTypes.map((a) => a.name).join(', ')} — by minimum deposit, account specialist, leverage, company funding, insured trades and investment plans.`}
  crumbs={[{ label: 'Trading Accounts', href: '/accounts' }]}
  crumbNav={false}
>
  <MarketCrumbs trail={[{ label: 'Trading Accounts', href: '/accounts' }]} />

  <section class="bg-white">
    <div class="shell max-w-[1140px] pb-6 pt-[clamp(24px,4.3vw,65px)]">
      <div class="reveal flex flex-col gap-[18px]">
        <h1 class="t-display !font-semibold text-black">Account Types</h1>
        <h2 class="pt-[11px] text-[clamp(18px,1.78vw,27px)] font-medium leading-[1.0741] text-black">Choose yours</h2>
        <p class="max-w-[1110px] text-[16px] leading-[25px] text-black">
          Six investment accounts, from Standard to VIP. Each step up raises the minimum deposit and adds more: a dedicated specialist, higher leverage and company funding, more insured trades and wider access to investment plans. Compare them below and choose the one that fits you best.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#0A1526]">
    <div class="shell max-w-[1320px] pb-[clamp(32px,5.3vw,80px)]">
      <!-- Title tab: hangs from the top edge, framed in gold, with a short rule under it -->
      <div class="reveal mx-auto max-w-[900px]">
        <div class="rounded-b-[36px] border-x border-b border-[#D8B456]/60 bg-[#0E1C31] px-6 pb-4 pt-5">
          <h2 class="text-center text-[clamp(18px,2.4vw,32px)] font-bold uppercase leading-tight tracking-[0.02em] text-[#D8B456]">Global Investment Account Comparison</h2>
        </div>
        <div class="mx-auto -mt-px h-[2px] w-1/2" style="background:linear-gradient(90deg,transparent,#D8B456,transparent)"></div>
      </div>

      <ul class="reveal mt-[clamp(28px,4vw,52px)] grid grid-cols-1 gap-x-3 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6" aria-label={`${accountTypes.length} account types`}>
        {accountTypes.map((a) => {
          const m = metal[a.key] ?? metal.silver;
          const body = m.card ?? cardBg;
          const vip = a.key === 'vip';
          return (
            <li class="relative mx-auto w-full max-w-[320px] pt-[42px]">
              <!-- Frame: outer metal, gap, inner metal hairline, body -->
              <div class="absolute inset-x-0 bottom-0 top-[42px]" aria-hidden="true">
                <div class="absolute inset-0" style={`clip-path:${shape};background:${m.tone}`}></div>
                <div class="absolute inset-[3px]" style={`clip-path:${shape};background:${body}`}></div>
                <div class="absolute inset-[6px]" style={`clip-path:${shape};background:${m.tone};opacity:.55`}></div>
                <div class="absolute inset-[7px]" style={`clip-path:${shape};background:${body}`}></div>
              </div>

              <div class="relative flex flex-col items-center px-4 pb-12">
                <!-- Coin medallion over the top edge, name plate across it -->
                <div class="relative -mt-[42px] flex h-[96px] w-full justify-center">
                  <span
                    class="relative block h-[84px] w-[84px] rounded-full"
                    style={vip
                      ? `background:#121212;border:3px dotted ${m.tone};box-shadow:inset 0 0 0 3px #121212, inset 0 0 0 4px ${m.tone}`
                      : `background:${m.tone};box-shadow:inset 0 0 0 5px ${m.tone}, inset 0 0 0 6px ${m.deep}`}
                    aria-hidden="true"
                  >
                    {vip && <Fragment set:html={gem('absolute left-1/2 top-[6px] -translate-x-1/2') + gem('absolute bottom-[6px] left-1/2 -translate-x-1/2')} />}
                  </span>
                  <div class="absolute left-1/2 top-[30px] -translate-x-1/2 p-[2px]" style={`clip-path:${plate};background:${m.tone}`}>
                    <h3 class="whitespace-nowrap px-7 py-1.5 text-[19px] font-bold uppercase leading-6 tracking-[0.03em]" style={`clip-path:${plate};background:${m.deep};color:${cream}`}>{a.name}</h3>
                  </div>
                  {vip && <Fragment set:html={gem('absolute left-1/2 top-[40px] -translate-x-[74px]') + gem('absolute left-1/2 top-[40px] translate-x-[60px]')} />}
                </div>

                <p class="mt-1 text-center text-[15px] font-bold uppercase leading-5" style={`color:${cream}`}>Minimum deposit:</p>
                <p class="text-center text-[30px] font-bold leading-9" style={`color:${cream}`}>{a.minDeposit}</p>
                <div class="mt-2 h-[2px] w-3/4" style={`background:linear-gradient(90deg,transparent,${m.tone},transparent)`} aria-hidden="true"></div>

                <ul class="mt-2 w-full">
                  {a.features.map((f, j) => (
                    <li
                      class="flex items-start gap-2.5 py-2.5 text-[15px] font-medium leading-5 text-[#EEF1F5]"
                      style={j > 0 ? 'background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent) top/100% 1px no-repeat' : undefined}
                    >
                      <span class="mt-px flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-full border-[1.5px] border-[#D3D8E0] text-[#D3D8E0]" aria-hidden="true"><Icon name="check" size={11} /></span>{f}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })}
      </ul>

      <div class="reveal mt-[clamp(28px,4vw,52px)] flex items-center gap-4">
        <span class="h-[2px] flex-1" style="background:linear-gradient(90deg,transparent,#D8B456)" aria-hidden="true"></span>
        <p class="text-center text-[clamp(16px,2.2vw,30px)] font-bold uppercase tracking-[0.02em] text-[#D8B456]">Investment accounts only</p>
        <span class="h-[2px] flex-1" style="background:linear-gradient(90deg,#D8B456,transparent)" aria-hidden="true"></span>
      </div>

      <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={links.register} class="btn-primary">Open an Account</a>
      </div>
      <p class="mt-3 text-center text-[13px] leading-5 text-white/60">Leverage depends on your jurisdiction and client classification.</p>
    </div>
  </section>

  <section class="border-t border-[#e1e1e1] bg-white">
    <div class="shell max-w-[1140px] py-10">
      <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[14px] font-semibold text-black" aria-label="Account information">
        <a href="/education#faq" class="hover:text-brand">FAQs</a>
        <span class="h-4 w-px bg-[#c7c7c7]" aria-hidden="true"></span>
        <a href="/coming-soon" class="hover:text-brand">Legal</a>
        <span class="h-4 w-px bg-[#c7c7c7]" aria-hidden="true"></span>
        <a href="/contact" class="hover:text-brand">Contact Us</a>
      </nav>

      <div class="mt-8 grid gap-8 text-[13px] leading-[20px] text-[#444] md:grid-cols-3">
        <div>
          <h3 class="mb-2 !text-[14px] font-semibold text-black">Company Information:</h3>
          <p>This website (www.{site.domain}) is operated by {site.name}, a global trading brand providing secure, transparent access to the world’s financial markets. {site.name} is dedicated to the highest levels of security and regulation, and is licensed and regulated by multiple international financial authorities.</p>
          <p class="mt-2">{site.name} is the trading name under which these services are provided worldwide.</p>
        </div>
        <div>
          <h3 class="mb-2 !text-[14px] font-semibold text-black">Risk Warning:</h3>
          <p>
            CFDs are complex instruments and come with a high risk of losing money rapidly due to leverage.
            {compliance.lossPercentage && <> <b>{compliance.lossPercentage}</b></>}
            {' '}You should consider whether you understand how CFDs work and whether you can afford to take the high risk of losing your money. Past performance does not constitute a reliable indicator of future results. Future forecasts do not constitute a reliable indicator of future performance. Before deciding to trade, you should carefully consider your investment objectives, level of experience and risk tolerance. You should not deposit more than you are prepared to lose. Please ensure you fully understand the risk associated with the product envisaged and seek independent advice, if necessary. {site.name} does not issue advice, recommendations or opinions in relation to acquiring, holding or disposing of any financial product. {site.name} is not a financial adviser and all services are provided on an execution only basis.
          </p>
        </div>
        <div>
          <h3 class="mb-2 !text-[14px] font-semibold text-black">Regional Restrictions:</h3>
          <p>{site.name} offers its services in jurisdictions where such services are permitted under local regulation. {site.name} does not provide regulated financial services in jurisdictions where it is not licensed to do so.</p>
          <p class="mt-2">{site.name} does not issue advice, recommendations or opinions in relation to acquiring, holding or disposing of any financial product. {site.name} is not a financial adviser and all services are provided on an execution only basis.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
