// ---------------------------------------------------------------------------
// FAQ. Where an answer would require a figure we do not have, it says so.
// ---------------------------------------------------------------------------
const faqs = [
  {
    q: 'Do I need an account to use the education centre?',
    a:
      'No. Everything on this page is open to read without registering. An account becomes useful ' +
