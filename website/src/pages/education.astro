// ---------------------------------------------------------------------------
// Illustrations. Each slot renders only once an approved image path is set (here, or as
// `src` on an article or webinar card); until then the layout closes up instead of
// showing the image brief to visitors. The briefs stay in `label` and IMAGE-MANIFEST.md.
// ---------------------------------------------------------------------------
const educationImages = {
  hero: null,            // learner at a desk with chart and lesson list, 720×480
  strategyStyles: null,  // four labelled strategy charts, 620×520
  orderTicket: null,     // annotated order ticket, 600×520
  riskSizing: null,      // dark position-sizing diagram, 620×460
};

// ---------------------------------------------------------------------------
