<Base
  title="Trading Education Centre — Learn Forex, CFDs and Risk"
  description="Free trading education from Orion Capital: beginner guides, strategy explainers, order types, risk management and a plain-English glossary — plus live webinars."
  crumbs={crumbs}
>

  <!-- 1 ── HERO (white) -------------------------------------------------- -->
  <PageHero
    eyebrow="Education centre"
    title="Learn how trading works before it costs you to find out"
    lead="Structured guides, strategy explainers and a risk section written to be genuinely useful — not a brochure. Start at the beginning, or jump to the part you are stuck on."
    primary={{ label: 'Practise on a free demo', href: links.demo }}
    secondary={{ label: 'Start with the basics', href: '#beginners' }}
    imageId="education-hero"
    imageLabel="Learner at a desk with a chart on one screen and an education module on the other: lesson list on the left, candlestick chart annotated with a support level on the right"
    imageSrc={educationImages.hero ?? undefined}
    image={Boolean(educationImages.hero)}
  />

  <!-- 2 ── LEARNING PATH (band) ------------------------------------------ -->
  <section id="path" class="section band scroll-mt-20 lg:scroll-mt-24" aria-labelledby="path-h">
    <div class="shell">

      <nav aria-label="On this page" class="mb-12 border border-line bg-white px-5 py-4">
        <p class="text-micro font-semibold uppercase tracking-[.14em] text-muted">On this page</p>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          {jump.map((j) => (
            <li>
              <a href={j.href} class="text-small font-medium text-navy hover:text-brand">
                {j.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-micro font-semibold uppercase tracking-[.16em] text-brand">
          Start here
        </p>
        <h2 id="path-h" class="text-balance">Three levels, in the order they actually help</h2>
        <p class="mt-4 text-body text-muted">
          Most people arrive in the middle — hunting for a strategy before they can size a position.
          The path below is deliberately boring at the start, because the mechanical ideas are the
          ones that decide whether anything later works. Move on when the previous level feels dull.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        {path.map((p) => (
          <div class="flex min-w-0 flex-col border border-line bg-white p-6 lg:p-7">
            <div class="flex items-center justify-between gap-3">
              <span class="text-micro font-semibold uppercase tracking-[.14em] text-muted tabular-nums">
                {p.level}
              </span>
              <span class="border border-brand/40 bg-band px-2 py-1 text-micro font-semibold uppercase tracking-[.1em] text-brand">
                {p.badge}
              </span>
            </div>

            <div class="mt-5 flex h-11 w-11 items-center justify-center bg-band text-brand">
              <Icon name={p.icon} size={22} />
            </div>

            <h3 class="mt-4 text-h4 text-ink">{p.title}</h3>
            <p class="mt-2 text-small text-muted">{p.text}</p>

            <ul class="mt-5 space-y-3 border-t border-line pt-5">
              {p.items.map((it) => (
                <li class="flex gap-3">
                  <span class="mt-[3px] shrink-0 text-brand"><Icon name="check" size={16} /></span>
                  <span class="text-small text-muted">{it}</span>
                </li>
              ))}
            </ul>

            <a
              href={p.cta.href}
              class="mt-auto inline-flex items-center gap-1 pt-6 text-small font-semibold text-brand hover:underline"
            >
              {p.cta.label}<Icon name="chevron-r" size={16} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 ── #beginners — ARTICLE GRID (white) ----------------------------- -->
  <section id="beginners" class="section bg-white scroll-mt-20 lg:scroll-mt-24" aria-labelledby="beginners-h">
    <div class="shell">
      <div class="mb-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <p class="mb-3 text-micro font-semibold uppercase tracking-[.16em] text-brand">
            Trading for beginners
          </p>
          <h2 id="beginners-h" class="text-balance">The six things to read first</h2>
          <p class="mt-4 text-body text-muted">
            Short, plain-English guides with worked examples instead of jargon. Read them in any
            order, but read the sizing one before you place a live trade — it is the one that
            changes behaviour.
          </p>
        </div>
        <a href={links.demo} class="btn-outline shrink-0">
          Practise on a demo<Icon name="chevron-r" size={16} />
        </a>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((a) => (
          <article class="flex min-w-0 flex-col border border-line bg-white">
            {a.src && <Placeholder id={a.id} src={a.src} alt={a.title} w={640} h={400} />}
            <div class="flex flex-1 flex-col p-5 lg:p-6">
              <p class="text-micro font-semibold uppercase tracking-[.14em] text-brand">
                {a.category}
              </p>
              <h3 class="mt-2 text-h4 text-ink">
                {a.href ? <a href={a.href} class="hover:text-brand">{a.title}</a> : a.title}
              </h3>
              <p class="mt-2 text-small text-muted">{a.dek}</p>
              <div class="mt-auto flex items-center gap-2 border-t border-line pt-4 text-micro text-muted">
                <Icon name="clock" size={14} />
                {a.href ? (
                  <span class="tabular-nums">{a.read} read</span>
                ) : (
                  <span class="font-semibold">Not yet published</span>
                )}
                <span aria-hidden="true">&middot;</span>
                <span>{a.level}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10 border border-line bg-band p-5 lg:p-6">
        <p class="text-small font-semibold text-ink">About these six guides</p>
        <p class="mt-2 max-w-3xl text-small text-muted">
          The titles, categories and ordering above are the final editorial plan for this section.
          The articles are being written; each card links to its guide, with its reading time, as
          soon as that guide is published.
        </p>
        <span class={todo}>
        </span>
      </div>
    </div>
  </section>

  <!-- 4 ── #strategies (band) -------------------------------------------- -->
  <section id="strategies" class="section band scroll-mt-20 lg:scroll-mt-24" aria-labelledby="strategies-h">
    <div class="shell">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-micro font-semibold uppercase tracking-[.16em] text-brand">
          Trading strategies
        </p>
        <h2 id="strategies-h" class="text-balance">Four styles, and how each one fails</h2>
        <p class="mt-4 text-body text-muted">
          Every strategy is a bet on how a market behaves. When the market behaves differently, the
          strategy loses — predictably, in its own characteristic way. Knowing that failure mode in
          advance is more useful than knowing the entry rule, so each card below states it plainly.
        </p>
      </div>

      <div class="grid items-start gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:gap-14">
        <div class="grid min-w-0 gap-6 sm:grid-cols-2">
          {strategies.map((s) => (
            <div class="flex min-w-0 flex-col border border-line bg-white p-6">
              <div class="flex items-start justify-between gap-3">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center bg-band text-brand">
                  <Icon name={s.icon} size={22} />
                </div>
                <span class="border border-line bg-band px-2 py-1 text-micro font-medium text-muted">
                  {s.horizon}
                </span>
              </div>

              <h3 class="mt-4 text-h4 text-ink">{s.name}</h3>
              <p class="mt-2 text-small font-medium text-ink">{s.assumes}</p>
              <p class="mt-3 text-small text-muted">{s.body}</p>

              <dl class="mt-5 space-y-3 border-t border-line pt-4">
                <div>
                  <dt class="text-micro font-semibold uppercase tracking-[.1em] text-muted">
                    What it demands of you
                  </dt>
                  <dd class="mt-1 text-small text-muted">{s.demands}</dd>
                </div>
                <div>
                  <dt class="text-micro font-semibold uppercase tracking-[.1em] text-brand">
                    How it fails
                  </dt>
                  <dd class="mt-1 text-small text-muted">{s.fails}</dd>
                </div>
              </dl>
            </div>
          ))}
        </div>

        <div class="min-w-0 lg:w-full lg:justify-self-end">
          {educationImages.strategyStyles && (
            <div class="mb-6">
              <Placeholder id="education-strategy-styles" src={educationImages.strategyStyles} alt="" w={620} h={520} />
            </div>
          )}

          <div class="border border-line bg-white p-5">
            <h3 class="text-h4 text-ink">Choosing between them</h3>
            <p class="mt-2 text-small text-muted">
              Match the style to your schedule before you match it to a market. A method that needs
              you watching a five-minute chart is not a method if you work during market hours, and
              a strategy you abandon after two bad weeks was never tested at all.
            </p>
            <ul class="mt-4 space-y-3">
              <li class="flex gap-3">
                <span class="mt-[3px] shrink-0 text-brand"><Icon name="check" size={16} /></span>
                <span class="text-small text-muted">
                  Decide how many hours a week you can genuinely give it.
                </span>
              </li>
              <li class="flex gap-3">
                <span class="mt-[3px] shrink-0 text-brand"><Icon name="check" size={16} /></span>
                <span class="text-small text-muted">
                  Write the rules down before testing, not after.
                </span>
              </li>
              <li class="flex gap-3">
                <span class="mt-[3px] shrink-0 text-brand"><Icon name="check" size={16} /></span>
                <span class="text-small text-muted">
                  Run it on a demo long enough to meet its failure mode once.
                </span>
              </li>
            </ul>
            <div class="mt-5 flex flex-wrap gap-3">
              <a href={links.demo} class="btn-primary btn-sm">Open a demo</a>
              <a href="/markets/forex" class="btn-ghost btn-sm">
                Markets to practise on<Icon name="chevron-r" size={14} />
              </a>
            </div>
          </div>

          <p class="mt-5 text-small text-muted">
            Nothing in this section is a recommendation or a forecast, and no strategy described
            here has a dependable outcome. {compliance.riskWarningShort}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 ── #orders — ORDER TYPE TABLE (white) ---------------------------- -->
  <section id="orders" class="section bg-white scroll-mt-20 lg:scroll-mt-24" aria-labelledby="orders-h">
    <div class="shell">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-micro font-semibold uppercase tracking-[.16em] text-brand">
          Order types
        </p>
        <h2 id="orders-h" class="text-balance">Six orders, and the job each one does</h2>
        <p class="mt-4 text-body text-muted">
          An order type is a sentence you write to the market in advance: do this, at this price, in
          this circumstance. Choosing the wrong one is how traders end up entering at prices they
          never agreed to. Three of the six are entries, two are exits you set in advance, and one is
          an exit that follows the price as the trade moves.
        </p>
      </div>

      <div class="grid items-start gap-10 lg:grid-cols-[1.35fr_0.65fr] lg:gap-14">
        <div class="min-w-0">
          <div class="overflow-x-auto border border-line">
            <table class="w-full min-w-[760px] text-small">
              <caption class="sr-only">
                Standard order types: what each one does and when to use it
              </caption>
              <thead>
                <tr class="border-b border-line bg-band text-left text-micro uppercase tracking-wide text-muted">
                  <th scope="col" class="w-[22%] px-4 py-3 font-medium">Order type</th>
                  <th scope="col" class="w-[39%] px-4 py-3 font-medium">What it does</th>
                  <th scope="col" class="w-[39%] px-4 py-3 font-medium">When to use it</th>
                </tr>
              </thead>
              <tbody>
                {orderTypes.map((o) => (
                  <tr class="border-b border-line align-top last:border-0 hover:bg-band/50">
                    <th scope="row" class="px-4 py-5 text-left">
                      <span class="block font-semibold text-ink">{o.name}</span>
                      <span class="mt-1 block text-micro text-muted">{o.kind}</span>
                    </th>
                    <td class="px-4 py-5 text-muted">{o.does}</td>
                    <td class="px-4 py-5 text-muted">{o.when}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="mt-6 border border-line bg-band p-5">
            <p class="text-small font-semibold text-ink">Two things the table cannot promise</p>
            <p class="mt-2 text-small text-muted">
              First, a triggered order executes at the next available price, not at your trigger —
              in fast markets, around data releases and at the open after a gap, the difference can
              be material. Second, the set of order types you can place depends on the platform and
              the instrument, so the list above is the industry vocabulary rather than a statement
              of what is enabled on your account.
            </p>
            <span class={todo}>
            </span>
            <div class="mt-5 flex flex-wrap gap-3">
              <a href="/trading-platforms/webtrader" class="btn-outline btn-sm">
                See the WebTrader ticket<Icon name="chevron-r" size={14} />
              </a>
            </div>
          </div>
        </div>

        <div class="min-w-0 lg:w-full lg:justify-self-end">
          {educationImages.orderTicket && (
            <div class="mb-6">
              <Placeholder id="education-order-ticket-annotated" src={educationImages.orderTicket} alt="" w={600} h={520} />
            </div>
          )}

          <div class="border border-line p-5">
            <h3 class="text-h4 text-ink">A habit worth forming</h3>
            <p class="mt-2 text-small text-muted">
              Fill the ticket from the bottom up: decide the stop first, then the size that makes
              that stop an acceptable loss, and only then the entry. Done in that order, the
              arithmetic protects you. Done in the usual order, the entry decides your risk for you.
            </p>
            <a
              href={links.webtrader}
              class="mt-4 inline-flex items-center gap-1 text-small font-semibold text-brand hover:underline"
            >
              Try it in WebTrader<Icon name="chevron-r" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 ── #risk (dark) -------------------------------------------------- -->
  <section id="risk" class="section band-dark scroll-mt-20 lg:scroll-mt-24" aria-labelledby="risk-h">
    <div class="shell">
      <div class="mb-12 max-w-3xl">
        <p class="mb-3 text-micro font-semibold uppercase tracking-[.16em] text-sky">
          Risk management
        </p>
        <h2 id="risk-h" class="text-balance">Risk management is not a module. It is the job.</h2>
        <p class="mt-4 text-body text-white/70">
          Traders who last are rarely the ones with the best forecasts. They are the ones still
          holding a balance after the forecasts were wrong, because the size of each position was
          decided in advance and the exit existed before it was needed. This section is written to
          be useful to someone who is currently losing money, which is the only audience it matters
          to.
        </p>
      </div>

      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div class="min-w-0">
          <div class="space-y-10">
            {riskPillars.map((r) => (
              <div class="min-w-0 border-t border-white/15 pt-6">
                <div class="mb-4 flex h-11 w-11 items-center justify-center bg-white/10 text-sky">
                  <Icon name={r.icon} size={22} />
                </div>
                <h3 class="text-h4 text-white">{r.title}</h3>
                <p class="mt-3 text-small text-white/70">{r.body}</p>
                <p class="mt-3 text-small text-white/65">{r.body2}</p>
                {/* Caps are read from compliance.maxLeverage in site.js, whose `note` carries
                    unverified placeholder caps. Never collapse the per-region caps into one global
                    figure, and never restate them in this file. */}
                {r.title === 'Leverage discipline' && leverage && (
                  <p class="mt-3 text-small text-white/65">
                    The ceiling itself is not one global number. Retail clients in the
                    EEA: {leverage.retailEea}. Retail clients under our international
                    entity: {leverage.retailIntl}. {leverage.note} The leverage and margin that
                    apply to your own account are shown in the client area before you place a trade.
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>

        <div class="min-w-0 lg:w-full lg:justify-self-end">
          {educationImages.riskSizing && (
            <div class="mb-6">
              <Placeholder id="education-risk-position-sizing" src={educationImages.riskSizing} alt="" w={620} h={460} dark={true} />
            </div>
          )}

          <div class="border border-white/15 bg-white/[0.04] p-5">
            <h3 class="text-h4 text-white">Six habits, in order of impact</h3>
            <ul class="mt-4 space-y-3">
              {riskHabits.map((h) => (
                <li class="flex gap-3">
                  <span class="mt-[3px] shrink-0 text-sky"><Icon name="check" size={16} /></span>
                  <span class="text-small text-white/70">{h}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 border border-white/15 p-5">
            <p class="text-small font-semibold text-white">Before you trade with real money</p>
            <p class="mt-2 text-small text-white/70">
              Leveraged trading is not suitable for everyone. It is possible to lose money quickly,
              and losing a meaningful share of a balance is a normal part of learning rather than a
              sign that something went unusually wrong. {compliance.riskWarningShort}
            </p>
            {/* The loss figure is read from compliance.lossPercentage in site.js, which carries
                an unverified placeholder figure. */}
            {compliance.lossPercentage && (
              <p class="mt-3 text-small font-semibold text-white">{compliance.lossPercentage}</p>
              )}
            <div class="mt-5 flex flex-wrap gap-3">
              <a href={links.demo} class="btn-primary btn-sm">Start on a demo</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7 ── #glossary (white) --------------------------------------------- -->
  <section id="glossary" class="section bg-white scroll-mt-20 lg:scroll-mt-24" aria-labelledby="glossary-h">
    <div class="shell">
      <div class="mb-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <p class="mb-3 text-micro font-semibold uppercase tracking-[.16em] text-brand">
            Market terms
          </p>
          <h2 id="glossary-h" class="text-balance">Twelve words you need before anything else</h2>
          <p class="mt-4 text-body text-muted">
            Trading vocabulary is small, and most of it is plain once someone defines it without
            circular jargon. These twelve cover nearly every sentence you will meet in a platform,
            an analysis piece or an order ticket.
          </p>
        </div>
        <a href="/markets/forex" class="btn-outline shrink-0">
          Forex terms in context<Icon name="chevron-r" size={16} />
        </a>
      </div>

      <dl class="grid gap-x-10 gap-y-8 border-t border-line pt-10 sm:grid-cols-2 lg:grid-cols-3">
        {glossary.map((g) => (
          <div class="min-w-0">
            <dt class="text-small font-semibold text-ink">{g.term}</dt>
            <dd class="mt-1 text-small text-muted">{g.def}</dd>
          </div>
        ))}
      </dl>

      <p class="mt-10 max-w-3xl text-small text-muted">
        These are general definitions of market vocabulary. None of them states a value that applies
        to an {site.name} account — the spread, leverage, margin and swap figures that apply to you
        depend on your account type, your instrument and where you are onboarded, and are shown in
        the client area before you trade.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/accounts" class="btn-ghost btn-sm">
          Account types<Icon name="chevron-r" size={14} />
        </a>
        <a href={links.clientArea} class="btn-ghost btn-sm">
          Open the client area<Icon name="chevron-r" size={14} />
        </a>
      </div>
    </div>
  </section>

  <!-- 8 ── #webinars (band) ---------------------------------------------- -->
  <section id="webinars" class="section band scroll-mt-20 lg:scroll-mt-24" aria-labelledby="webinars-h">
    <div class="shell">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-micro font-semibold uppercase tracking-[.16em] text-brand">
          Live webinars
        </p>
        <h2 id="webinars-h" class="text-balance">Upcoming live sessions</h2>
        <p class="mt-4 text-body text-muted">
          Time with the platform open and a presenter answering questions in real time. The format is
          screen-first — demonstrations on a live chart rather than slide decks. Attendance terms and
          the registration route are confirmed with each announced session.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        {webinars.map((w) => (
          <article class="flex min-w-0 flex-col border border-line bg-white">
            {w.src && <Placeholder id={w.id} src={w.src} alt={w.title} w={560} h={340} />}
            <div class="flex flex-1 flex-col p-5 lg:p-6">
              <div class="flex flex-wrap items-center gap-2">
                <span class="border border-brand/40 bg-band px-2 py-1 text-micro font-semibold uppercase tracking-[.1em] text-brand">
                  {w.badge}
                </span>
                <span class="inline-flex items-center gap-1 text-micro text-muted">
                  <Icon name="play" size={12} />Live
                </span>
              </div>

              <h3 class="mt-3 text-h4 text-ink">{w.title}</h3>

              {w.date ? (
                <dl class="mt-4 space-y-2 border-y border-line py-4 text-small">
                  <div class="flex flex-wrap items-baseline gap-x-2">
                    <dt class="text-micro font-semibold uppercase tracking-[.1em] text-muted">Date</dt>
                    <dd class="text-small text-ink">{w.date}</dd>
                  </div>
                  <div class="flex flex-wrap items-baseline gap-x-2">
                    <dt class="text-micro font-semibold uppercase tracking-[.1em] text-muted">Time</dt>
                    <dd class="text-small text-ink">{w.time}</dd>
                  </div>
                  <div class="flex flex-wrap items-baseline gap-x-2">
                    <dt class="text-micro font-semibold uppercase tracking-[.1em] text-muted">Host</dt>
                    <dd class="text-small text-ink">{w.host}</dd>
                  </div>
                </dl>
              ) : (
                <p class="mt-4 border-y border-line py-4 text-small text-muted">
                  Date, time and presenter to be announced.
                </p>
              )}

              <p class="mt-4 text-small text-muted">{w.dek}</p>
              <p class="mt-3 text-micro text-muted">{w.detail}</p>

              <div class="mt-auto pt-6">
                {w.date && w.register ? (
                  <a href={w.register} class="btn-primary btn-sm w-full">Reserve a seat</a>
                ) : (
                  <span class="btn-outline btn-sm w-full cursor-default opacity-60" aria-disabled="true">Registration not yet open</span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10 border border-line bg-white p-5 lg:p-6">
        <p class="text-small font-semibold text-ink">Schedule and recordings</p>
        <p class="mt-2 max-w-3xl text-small text-muted">
          The three sessions above are the standing programme. Each run is published here with its
          date, start time, time zone and presenter, and registration opens for that session at the
          same time.
        </p>
        <span class={todo}>
        </span>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={soon} class="btn-outline btn-sm">
            Market analysis &amp; news<Icon name="chevron-r" size={14} />
          </a>
          <a href="/trading-platforms" class="btn-ghost btn-sm">
            Platforms overview<Icon name="chevron-r" size={14} />
