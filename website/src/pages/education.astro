---
// Education centre — the hub the "Learn" mega-menu and the footer both point at.
//
// Six of the nav's deep links are anchors on this page rather than separate
// routes, so the ids below are load-bearing and must not be renamed:
//   #beginners  #strategies  #orders  #risk  #glossary  #webinars
// (see src/data/nav.js — Learn column and the Education footer column). Each of
// those sections carries `scroll-mt-20 lg:scroll-mt-24` so the sticky header does
// not sit over the heading when a link lands on it.
//
// Editorial stance: this page teaches first. A broker education hub that reads as
// a sales funnel teaches nothing, and the risk band in particular is written to be
// useful to someone who is about to lose money rather than to someone we want to
// sign up. Conversion lives in the hero, the CTA band and the inline demo links.
//
// Section rhythm (strictly alternating, per BRIEF.md):
//   hero white -> learning path band -> articles white -> strategies band ->
//   order types white -> risk dark -> glossary white -> webinars band ->
//   FAQ white -> CTA dark.
//
// No regulatory or pricing value is written in this file. Leverage caps and the loss
// figure are read from `compliance` in src/config/site.js; account minimums and funding
// methods come from src/data/pricing.js. Both files carry their own "[SAMPLE]" markers
// inside the strings, so the sample status still shows on the page — they are not wrapped
// in a TODO chip as well. Only genuine unknowns with no config field keep a visible chip:
// guaranteed stops, the per-platform order list, the margin close-out level and the
// webinar calendar.
//
// Platforms: WebTrader is the only platform live today. Copy trading exists in the nav as
// not-yet-built and may be described as planned, never as available.
// This firm does not offer MT4 or MT5 — do not reintroduce a MetaTrader reference here.
import Base from '../layouts/Base.astro';
import PageHero from '../components/sections/PageHero.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTABand from '../components/sections/CTABand.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import Icon from '../components/ui/Icon.astro';
import { links, site, compliance } from '../config/site.js';
import { accountTypes, paymentMethods, pricingIsSample } from '../data/pricing.js';

const crumbs = [{ label: 'Education', href: '/education' }];

// Visible TODO chips — same convention as the homepage, About, Forex and WebTrader pages.
const todo = 'mt-3 inline-block border border-dashed border-brand/70 bg-brand/[0.06] px-2 py-1 text-micro font-medium text-brand site-todo';
const todoDark = 'mt-3 inline-block border border-dashed border-sky/60 bg-white/[0.06] px-2 py-1 text-micro font-medium text-sky site-todo';

// Unbuilt routes resolve to /coming-soon, matching src/data/nav.js, so no link
// on this page can 404 before the rest of the taxonomy lands.
const soon = '/coming-soon';

// ---------------------------------------------------------------------------
// Shared facts, read once from config so this page cannot drift away from the
// fees page. `compliance.maxLeverage` is an object of per-region caps and must
// never be collapsed into one global number; its `note` carries the [SAMPLE]
// marker, so no extra TODO chrome is needed around it.
// ---------------------------------------------------------------------------
const leverage = compliance.maxLeverage;
// Every tier's minimum, in the order pricing.js lists them.
const tierMinimums = accountTypes.map((a) => a.name + ' from ' + a.minDeposit).join(', ');

// pricing.js figures carry no inline marker of their own, so the sample status is
// appended once here and reused wherever a number from that file is quoted.
const samplePricingNote = pricingIsSample
  ? ' '
  : '';

const methodNames = paymentMethods.map((m) => m.name);
const fundingMethods =
  methodNames.slice(0, -1).join(', ') + ' and ' + methodNames[methodNames.length - 1];

// ---------------------------------------------------------------------------
// In-page jump nav. These are the anchors the mega-menu links to, surfaced for
// readers who arrive at the top of the hub.
// ---------------------------------------------------------------------------
const jump = [
  { label: 'Start here', href: '#path' },
  { label: 'For beginners', href: '#beginners' },
  { label: 'Strategies', href: '#strategies' },
  { label: 'Order types', href: '#orders' },
  { label: 'Risk management', href: '#risk' },
  { label: 'Glossary', href: '#glossary' },
  { label: 'Webinars', href: '#webinars' },
];

// ---------------------------------------------------------------------------
