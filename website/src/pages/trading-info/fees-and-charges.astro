---
// Fees and Charges — laid out to Figma frame 72:2 on the guide template: accent hero,
// stats strip, then two sections with a sticky table of contents. Copy is the frame's
// with "AvaTrade" → "Orion Capital". The per-currency fee amounts come from
// src/data/pricing.js (`inactivityFee`, `adminFee`), the same source as `feeSchedule`,
// so this page and the other pages that quote the fees cannot drift apart.
// Account tiers and spreads by tier live on /accounts.
import GuideLayout from '../../components/market/GuideLayout.astro';
import GuideSection from '../../components/market/GuideSection.astro';
import GuideList from '../../components/market/GuideList.astro';
import GuideBits from '../../components/market/GuideBits.astro';
import { inactivityFee, adminFee } from '../../data/pricing.js';

const toc = [
  { id: 'spreads', label: 'Buy/Sell Spreads' },
  { id: 'additional-fees', label: 'Additional Fees' },
];
const byCurrency = (fees: Record<string, string>) =>
  Object.entries(fees).map(([ccy, amount]) => ({ html: `${ccy} Account: ${amount}` }));
---
<GuideLayout
  meta={{
    title: 'Fees and Charges | Orion Capital',
    description: 'How Orion Capital is paid through the buy/sell spread, and the overnight premium, inactivity fee and administration fee that can apply to your account.',
  }}
  trail={[{ label: 'Trading Info' }, { label: 'Our Fees and Charges', href: '/trading-info/fees-and-charges' }]}
  hero={{
    title: 'A Guide to Fees and Charges',
    lead: 'Orion Capital is upfront about every cost, helping you trade with full transparency. Check our fees and charges to see how spreads, overnight premiums and inactivity fees work.',
    image: '/images/trading-info/fees-hero.webp',
    imageAlt: 'A calculator reading FEES with coins and a percent sign',
    cta: 'Learn More',
    ctaHref: '#spreads',
  }}
  toc={toc}
>
  <GuideSection id="spreads" title="Buy/Sell Spreads">
    <p>Orion Capital is compensated for its services through the Buy/Sell (Bid/Ask) spread, so when you open a position, you essentially “pay” the spread. This spread is incorporated into the Orion Capital quoted rates and is not an additional charge or fee payable by you above the quoted rates.</p>
    <p>To view the spread for a specific instrument, simply:</p>
    <GuideList text="lg" items={[
      { html: 'Log in to your account.' },
      { html: 'Search for a specific instrument.' },
      { html: 'Click on the Details icon (i) and scroll down to the Info section.' },
    ]} />
    <GuideBits kind="cta" />
  </GuideSection>

  <GuideSection id="additional-fees" title="Additional Fees" tone="band">
    <p>The fees below could be applied to your account, depending on your trading activity:</p>

    <h3>Overnight Premium</h3>
    <p>An overnight premium is deducted from your account when holding a position after a certain time (referred to as the “Overnight Funding Time”).</p>

    <h3>Inactivity Fee</h3>
    <p>Customer acknowledges that the Customer’s trading account may be subject to inactivity fees unless prohibited by law. After 3 consecutive months of non-use (“Inactivity Period”), and every successive Inactivity Period, an inactivity fee will be deducted from the value of the Customer’s trading account. This fee is outlined below and subject to customer’s relevant currency-based account:</p>
    <p>Inactivity Fee by Currency:</p>
    <GuideList text="lg" items={byCurrency(inactivityFee)} />
    <p>*Unless prohibited by Law.<br />**Applicable fees subject to change periodically.</p>

    <h3>Administration fee</h3>
    <p>Your trading account may be subject to an annual administration fee unless prohibited by law. After 12 consecutive months of non-use (“Annual Inactivity Period”), an administration fee will be deducted from the value of your trading account. This fee is outlined below and subject to the relevant currency-based account. This is to offset the cost incurred in making the service available, even though it may not be used.</p>
    <GuideList text="lg" items={byCurrency(adminFee)} />
    <p>Applicable fees subject to change periodically</p>
    <GuideBits kind="cta" />
  </GuideSection>
</GuideLayout>
