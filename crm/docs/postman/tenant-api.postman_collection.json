    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Sanctum bearer token. Auto-set by Login/Register tests."
    },
    {
      "key": "platform_id",
      "value": "",
      "type": "string",
      "description": "Auto-set by Platforms > Create."
    },
    {
      "key": "domain_id",
