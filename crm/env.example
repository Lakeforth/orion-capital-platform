# NCapital Pro — back office environment template.
# Names only. Every value has been removed; supply your own.

APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=true


APP_URL=
APP_DOMAIN=
PLATFORM_URL_DOMAIN="${APP_DOMAIN}"

# Local dev: skip bitrace_enabled tenant check (also auto-enabled when APP_ENV=local)
RECOVERY_MODULE_BYPASS=true
PLATFORM_URL_SCHEME=
PLATFORM_CLIENT_AREA_PREFIX=
PLATFORM_CRM_BACKOFFICE_PREFIX=
PLATFORM_WEBTRADER_PREFIX=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

APP_LOCALE=
APP_FALLBACK_LOCALE=
APP_FAKER_LOCALE=

APP_MAINTENANCE_DRIVER=
APP_MAINTENANCE_STORE=

BCRYPT_ROUNDS=12

LOG_CHANNEL=
LOG_STACK=
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=

DB_CONNECTION=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=
SESSION_DOMAIN=null

BROADCAST_CONNECTION=
FILESYSTEM_DISK=
QUEUE_CONNECTION=

CACHE_STORE=
CACHE_PREFIX=

MEMCACHED_HOST=

REDIS_CLIENT=
REDIS_HOST=
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PUSHER_APP_ID=1977125
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
PUSHER_SCHEME=
PUSHER_PORT=443

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

EMS_API_URL=
EMS_API_KEY=

# Google Drive integration (Settings > Integrations).
# One OAuth client for the whole platform; each company links its own Google account.
# Leave GOOGLE_REDIRECT_URI unset on multi-tenant installs: the callback URL is derived from
# the host being served, so each broker backoffice gets its own. Set it only to pin a single
# fixed URI. Whatever is used must be registered verbatim in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Browser-side Picker needs its own restricted API key and the Cloud project number.
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
