{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "blade-ui-kit/blade-heroicons": "^2.2",
        "blade-ui-kit/blade-icons": "^1.6",
        "codeat3/blade-carbon-icons": "^2.22",
        "codeat3/blade-google-material-design-icons": "^1.18",
        "codeat3/blade-radix-icons": "^1.6",
        "doctrine/dbal": "^4.2",
        "ems-api/php-client": "^1.0",
        "intervention/image-laravel": "^1.3",
        "lab404/laravel-impersonate": "^1.7",
        "laravel-notification-channels/telegram": "^6.0",
        "laravel/framework": "^11.0",
        "laravel/horizon": "^5.28",
        "laravel/reverb": "@beta",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "league/csv": "^9.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "matanyadaev/laravel-eloquent-spatial": "^4.2",
        "maxmind-db/reader": "^1.12",
        "opcodesio/log-viewer": "^3.8",
        "openai-php/laravel": "^0.10.2",
        "protonemedia/laravel-splade": "^1.4",
        "protonemedia/laravel-splade-breeze": "^2.5",
        "pusher/pusher-php-server": "^7.2",
        "qcod/laravel-settings": "^1.2",
        "ratchet/pawl": "0.4.1",
        "santigarcor/laratrust": "^8.3",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-sluggable": "^3.6",
        "stripe/stripe-php": "^21.3",
        "unisharp/laravel-filemanager": "^2.9",
        "yadahan/laravel-authentication-log": "^1.7"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "fakerphp/faker": "^1.23",
        "laravel/dusk": "^8.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-laravel": "^2.3",
        "protonemedia/laravel-dusk-fakes": "^1.6",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
