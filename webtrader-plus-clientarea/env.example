# NCapital Pro — client area environment template. Names only.

# Pusher Credentials
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=

# API Base URL (Primary source for the application)
VITE_API_URL=

# Local dev with Vite proxy (vite.config.ts forwards /api to php artisan serve):
# VITE_API_URL=http://localhost:5174/api/v1

# Maximum file upload size in bytes (10MB default)
VITE_MAX_UPLOAD_SIZE=

# Optional: treat recovery module as enabled without tenant bitrace_enabled setting
# VITE_RECOVERY_MODULE_BYPASS=true
